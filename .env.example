# EasyShare / ShareShelf AI Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (SQLite default; can be switched to PostgreSQL)
DATABASE_URL=sqlite:///easyshare.db
# For PostgreSQL: postgresql://username:password@localhost:5432/easyshare

# Upload settings
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
UPLOAD_FOLDER=app/static/uploads

# App Settings
SITE_NAME=EasyShare
SITE_TAGLINE=Borrow. Lend. Sell. Reuse.
TRUST_SCORE_INITIAL=100.0
